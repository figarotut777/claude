# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/price_scanner
REDIS_URL=redis://localhost:6379

# API Keys для маркетплейсов
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
AMAZON_API_KEY=your_amazon_api_key_here
EBAY_API_KEY=your_ebay_api_key_here
ALIEXPRESS_API_KEY=your_aliexpress_api_key_here

# JWT & Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# App Settings
DEBUG=true
LOG_LEVEL=INFO
WORKERS=4

# Rate Limiting
RATE_LIMIT_FREE=10
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=10000

# Cache TTL (seconds)
CACHE_TTL_IMAGE_SEARCH=3600
CACHE_TTL_TEXT_SEARCH=1800
CACHE_TTL_URL_PARSE=7200
CACHE_TTL_PRODUCT=86400

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Price-Scanner
