# Application Settings
APP_NAME="Price Comparison Service"
APP_VERSION="0.1.0"
DEBUG=true

# API Keys (когда появятся официальные API)
YANDEX_MARKET_API_KEY=
WILDBERRIES_API_KEY=
OZON_API_KEY=

# Provider Settings
ENABLE_YANDEX_MARKET=true
ENABLE_WILDBERRIES=true
ENABLE_OZON=true

# Парсинг настройки
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
REQUEST_TIMEOUT=10

# Matcher Settings
MIN_SIMILARITY_THRESHOLD=0.85
USE_IMAGE_COMPARISON=false

# Cache (для будущей реализации)
CACHE_ENABLED=false
CACHE_TTL=3600
