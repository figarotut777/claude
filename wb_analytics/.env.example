# Wildberries Analytics - Конфигурация

# API ключ Wildberries (обязательно!)
# Получить можно в личном кабинете продавца WB: Настройки -> Доступ к API
WB_API_KEY=your_wildberries_api_key_here

# Путь к базе данных SQLite
DB_PATH=wb_analytics/data/wb_analytics.db

# Настройки веб-сервера
PORT=5000
DEBUG=False

# Логирование
LOG_LEVEL=INFO
LOG_FILE=wb_analytics/logs/app.log

# Настройки синхронизации
# Количество дней истории для первичной загрузки
INITIAL_SYNC_DAYS=30

# Количество дней для хранения данных (старые данные удаляются)
DATA_RETENTION_DAYS=90

# Комиссия Wildberries по умолчанию (%)
DEFAULT_WB_COMMISSION=15.0
